# ─────────────────────────────────────────────────────────────────────────────
# Production environment variables for the VPS
# Copy this file to .env on your VPS and fill in real values.
# NEVER commit a filled-in version of this file.
# ─────────────────────────────────────────────────────────────────────────────

# Django core
DEBUG=false
SECRET_KEY=CHANGE_ME_use_a_long_random_string_here

# The VPS domain (no trailing slash)
ALLOWED_HOSTS=SmartSearchapi.culturemind.org

# CORS: comma-separated list of your Vercel frontend origins
# Add your custom domain if you set one in Vercel.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-frontend-domain.com

# PostgreSQL
DB_NAME=smartsearch
DB_USER=smartsearch_user
DB_PASSWORD=CHANGE_ME_db_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis (local to VPS)
REDIS_URL=redis://127.0.0.1:6379/1

# Cache TTLs (seconds) — adjust as needed
CACHE_TTL_SEARCH=600
CACHE_TTL_PRODUCT=900
CACHE_TTL_CATEGORIES=3600
CACHE_TTL_BRANDS=3600
CACHE_TTL_RELATED=900
CACHE_TTL_RECOMMENDATIONS=900
