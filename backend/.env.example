DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Local dev without PostgreSQL / Redis (copy to `.env` to run immediately) ---
# USE_SQLITE=1
# DISABLE_REDIS_CACHE=true

# --- PostgreSQL (production or when USE_SQLITE=0) ---
USE_SQLITE=0
DB_NAME=smartsearch
DB_USER=postgres
DB_PASSWORD=your-actual-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/1
DISABLE_REDIS_CACHE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
