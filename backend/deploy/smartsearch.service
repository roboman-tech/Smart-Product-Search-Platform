# /etc/systemd/system/smartsearch.service
# Enable:  sudo systemctl enable smartsearch
# Start:   sudo systemctl start  smartsearch
# Restart: sudo systemctl restart smartsearch
# Logs:    sudo journalctl -u smartsearch -f

[Unit]
Description=SmartSearch Django API (Gunicorn)
After=network.target postgresql.service redis.service

[Service]
Type=notify
User=www-data
Group=www-data

# Adjust this path to wherever you cloned the repo on the VPS
WorkingDirectory=/var/www/smartsearch/backend

# Load the production .env
EnvironmentFile=/var/www/smartsearch/backend/.env

ExecStart=/var/www/smartsearch/venv/bin/gunicorn \
    -c /var/www/smartsearch/backend/gunicorn.conf.py \
    ecommerce.wsgi:application

Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
